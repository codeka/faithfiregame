{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug Game (CodeLLDB)",
            "cargo": {
                "args": [
                    "build",
                    "--bin=game",
                    "--package=game"
                ],
                "filter": {
                    "name": "game",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "cppvsdbg",
            "request": "launch",
            "name": "Debug Game (MSVC)",
            "program": "${workspaceFolder}/target/debug/game.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "console": "integratedTerminal",
            "preLaunchTask": "cargo build"
        }
    ]
}